################################################################################
# Unity .gitignore (Enhanced for lightweight GitHub pushing)
# Place this file at the root of your Unity project.
################################################################################

# -------------------------------------------------------------------------------
# Unity generated folders (DO NOT COMMIT)
# -------------------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity can generate these in some environments
[Uu]nity[Pp]ackage[Mm]anager/
.vs/
.gradle/
ExportedObj/
.consulo/

# -------------------------------------------------------------------------------
# OS / Editor junk
# -------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# JetBrains / Rider
.idea/
*.DotSettings.user
*.DotSettings

# VS Code (keep if you want to share settings; otherwise ignore)
.vscode/
# If you prefer to keep only specific VS Code files, comment the line above
# and uncomment these instead:
# .vscode/extensions.json
# .vscode/launch.json
# .vscode/settings.json

# -------------------------------------------------------------------------------
# Visual Studio / Mono / IDE generated project files (DO NOT COMMIT)
# -------------------------------------------------------------------------------
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb

# Unity3D generated meta files for those
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash / log artifacts
sysinfo.txt
mono_crash.*
*.log

# Blender backup files (Unity can import .blend)
*.blend1
*.blend1.meta

# -------------------------------------------------------------------------------
# Builds / packages (usually don't commit build outputs)
# -------------------------------------------------------------------------------
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Crashlytics
crashlytics-build.properties

# TestRunner auto-generated scenes
InitTestScene*.unity*

# -------------------------------------------------------------------------------
# Addressables (default ignores; keep if you use Addressables)
# -------------------------------------------------------------------------------
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# -------------------------------------------------------------------------------
# Visual Scripting auto-generated files
# -------------------------------------------------------------------------------
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

################################################################################
# Custom (Project-specific) - Fix "Files too large" + keep repo lightweight
################################################################################

# Unity baked lighting / GI data (often huge; can be regenerated)
**/LightingData*.asset
**/LightingData*.asset.meta

# Lightmap textures (can become huge; regenerate by rebake)
**/Lightmap-*.exr
**/Lightmap-*.exr.meta
**/Lightmap-*.png
**/Lightmap-*.png.meta

# If you import large 3rd-party demo/sample packs and DON'T want them on GitHub,
# uncomment the line below (recommended if you only need code/core project files).
# Assets/Versatile Studio Assets/

# If you prefer to still keep the asset pack but ignore only its baked lighting file(s),
# keep the line above commented and rely on LightingData ignores only.

################################################################################
# End
################################################################################
