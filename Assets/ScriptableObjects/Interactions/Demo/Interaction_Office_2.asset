  m_Script: {fileID: 11500000, guid: cceab300df2e2fa4d8871bb641948b4a, type: 3}
  m_Name: Interaction_Office_2
  m_EditorClassIdentifier: Assembly-CSharp::SeriousGame.Content.InteractionSO
  interactionId: I01
  type: 4
  dialogueLines:
  - "Minh: \u201CCon ch\xE0o c\xF4 \u1EA1, con l\xE0 t\xE2n sinh vi\xEAn t\xF2a A.\u201D"
  - "C\xF4 v\u0103n ph\xF2ng: \u201CR\u1ED3i, con cho c\xF4 xem th\xF4ng tin \u0111\u0103ng
    k\xFD. C\xF3 m\xE3 h\u1ED3 s\u01A1 th\xEC \u0111\u01B0a, kh\xF4ng th\xEC m\u1EDF
    email x\xE1c nh\u1EADn.\u201D"
  - "L\u1EE5c l\u1ECDi c\xE1c th\u1EE9 \u2026 t\xECm \u0111\u01B0\u1EE3c email"
  - "Minh: \u201CD\u1EA1, email c\u1EE7a con \u0111\xE2y \u1EA1\u201D"
  - "C\xF4 v\u0103n ph\xF2ng: \u201C\u1EEAm, \u0111\xFAng r\u1ED3i.\u201D \u2026
    \u201CCon t\xEAn Minh, ph\xF2ng 210 \u0111\xFAng kh\xF4ng?\u201D"
  - "Minh: \u201CD\u1EA1.\u201D"
  - "C\xF4 v\u0103n ph\xF2ng: \u201C\u0110\xE2y l\xE0 th\u1EBB ra v\xE0o. Con gi\u1EEF
    k\u1EF9. Ra v\xF4 khu n\xE0y c\xF3 ch\u1ED7 qu\u1EB9t th\u1EBB. M\u1EA5t th\u1EBB
    l\xE0 phi\u1EC1n l\u1EAFm.\u201D"
  - "C\xF4 v\u0103n ph\xF2ng: C\xF2n nh\xF3m ZALO  th\xF4ng b\xE1o c\u1EE7a t\xF2a\u2026 
    con qu\xE9t QR \u1EDF b\u1EA3ng ph\xEDa b\xEAn kia l\xE0 v\xF4 \u0111\u01B0\u1EE3c
    nh\xE9"
  choices:
  - {fileID: 11400000, guid: 8b5935713211dde46a6568d8e97efb0b, type: 2}
  - {fileID: 11400000, guid: e2735dc3142e4b94e8803e153710cd7a, type: 2}
