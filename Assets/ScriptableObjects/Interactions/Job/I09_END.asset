  m_Script: {fileID: 11500000, guid: cceab300df2e2fa4d8871bb641948b4a, type: 3}
  m_Name: I09_END
  m_EditorClassIdentifier: Assembly-CSharp::SeriousGame.Content.InteractionSO
  interactionId: 9
  type: 4
  dialogueLines:
  - "D\u1EA1, em g\u1EEDi r\u1ED3i \u0111\xF3 anh \u01A1i. C\xF3 g\xEC anh xem l\u1EA1i
    th\u1EED gi\xFAp em v\u1EDBi \u1EA1"
  - "Okay em nha. Em l\xE0m t\u1ED1t l\u1EAFm!"
  - "D\u1EA1, em c\u1EA3m \u01A1n anh \u1EA1!"
  - "Gi\u1EDD em c\u1EE9 v\u1EC1 ch\u1ED7 \u0111i, anh \u0111ang l\xE0m c\xE1i n\xE0y
    m\u1ED9t x\xEDu. Khi n\xE0o xong ch\u1EDD c\u1EA3 nh\xF3m t\u1EDBi m\xECnh h\u1ECDp
    nh\xE9!"
  - "[B\u1EA1n \u0111\xE3 ho\xE0n th\xE0nh c\xF4ng vi\u1EC7c m\u1ED9t c\xE1ch xu\u1EA5t
    s\u1EAFc! Th\u1EADt \u0111\xE1ng \u0111\u01B0\u1EE3c tuy\xEAn d\u01B0\u01A1ng!]"
  - "[Gi\u1EDD th\xEC ngh\u1EC9 ng\u01A1i ch\u1EDD \u0111\u1EE3i th\xF4i]"
  - "[B\u1EA1n c\xF3 ngh\u0129 l\xE0 m\xECnh th\xEDch c\xF4ng vi\u1EC7c n\xE0y kh\xF4ng
    nh\u1EC9?]"
  choices: []
