  m_Name: SIT2
  m_EditorClassIdentifier: Assembly-CSharp::SeriousGame.Content.InteractionSO
  interactionId: I07
  type: 4
  dialogueLines:
  - "\u0110\u01B0\u1EE3c r\u1ED3i, ti\u1EBFp t\u1EE5c vi\u1EC7c th\xF4i"
  - "C\xF3 v\u1EBB m\xECnh s\u1EBD ph\u1EA3i d\xF9ng nh\u1EEFng g\xEC \u0111\xE3
    \u0111\u1ECDc \u0111\u1EC3 ho\xE0n th\xE0nh ph\u1EA7n n\xE0y"
  - "[B\u1EA1n c\u1EA7n \u1EA5n E \u0111\u1EC3 v\xE0o m\xE0n h\xECnh m\xE1y t\xEDnh
    m\u1ED9t l\u1EA7n n\u1EEFa]"
  - "[Ti\u1EBFp \u0111\xF3 b\u1EA1n c\u1EA7n k\xE9o c\xE1c \xF4 t\u01B0\u01A1ng \u1EE9ng
    v\xE0o v\u1ECB tr\xED \u0111\xFAng c\u1EE7a n\xF3 trong b\xE0i b\xE1o c\xE1o
    n\xE0y]"
  - "[Sau khi xong th\xEC b\u1EA1n ch\u1EC9 c\u1EA7n \u1EA5n n\xFAt SEND \u0111\u1EC3
    g\u1EEDi]"
  choices: []
