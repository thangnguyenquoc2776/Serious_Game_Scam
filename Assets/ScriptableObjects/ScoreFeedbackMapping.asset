    - minInclusive: 76
      maxInclusive: 100
      ratingLabel: "T\u1ED1t "
      feedback: "B\u1EA1n ch\xEDnh l\xE0 m\u1ED9t 'hi\u1EC7p s\u0129 b\u1EA3o m\u1EADt'
